# Vendor 1.25.1, compiled as static ARM32 softfloat for the generic guest.
CONFIG_STATIC=y
CONFIG_LFS=y
CONFIG_LONG_OPTS=y
CONFIG_SHOW_USAGE=y
CONFIG_FEATURE_VERBOSE_USAGE=y
CONFIG_ASH=y
CONFIG_SH_IS_ASH=y
CONFIG_ASH_BASH_COMPAT=y
CONFIG_ASH_JOB_CONTROL=n
CONFIG_ASH_BUILTIN_TEST=n
CONFIG_ASH_BUILTIN_PRINTF=n
CONFIG_ASH_CMDCMD=n
CONFIG_ASH_ALIAS=n
CONFIG_ASH_RANDOM_SUPPORT=n
CONFIG_FEATURE_SH_STANDALONE=n
CONFIG_FEATURE_SH_NOFORK=n
CONFIG_FEATURE_SH_MATH=y
CONFIG_FEATURE_SH_MATH_64=y
CONFIG_TEST=y
CONFIG_FEATURE_TEST_64=y
CONFIG_PRINTF=y
CONFIG_ECHO=y
CONFIG_CAT=y
CONFIG_LS=y
CONFIG_FEATURE_LS_TIMESTAMPS=y
CONFIG_MKDIR=y
CONFIG_FEATURE_MKDIR_LONG_OPTIONS=y
CONFIG_MV=y
CONFIG_RM=y
CONFIG_RMDIR=y
CONFIG_FSYNC=y
CONFIG_READLINK=y
CONFIG_FEATURE_READLINK_FOLLOW=y
CONFIG_PWD=y
CONFIG_CMP=y
CONFIG_UNAME=y
CONFIG_SLEEP=y
CONFIG_FEATURE_FANCY_SLEEP=y
CONFIG_ENV=y
CONFIG_AWK=y
CONFIG_MOUNT=y
CONFIG_FEATURE_MOUNT_FLAGS=y
CONFIG_UMOUNT=y
